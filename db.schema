CREATE TABLE "sessions" (
  "id" VARCHAR(255),
  "shop" VARCHAR(255),
  "state" VARCHAR(255),
  "isOnline" BOOLEAN,
  "scope" TEXT,
  "expires" int4, 
  "accessToken" VARCHAR(255),
  "refreshToken" VARCHAR(255),
  "refreshTokenExpires" int8, 
  "userId" int8,
  "firstName" VARCHAR(255),
  "lastName" VARCHAR(255),
  "email" VARCHAR(255),
  "accountOwner" BOOLEAN,
  "locale" VARCHAR(255),
  "collaborator" BOOLEAN,
  "emailVerified" BOOLEAN,
  "created_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "updated_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY ("id")
);

CREATE INDEX idx_sessions_shop ON "sessions" ("shop");

CREATE TABLE "shop" (
  "id" UUID DEFAULT gen_random_uuid(),
  "shopify_id" VARCHAR(255),
  "primary_domain" VARCHAR(255),
  "shop_title" VARCHAR(255),
  "owner_name" VARCHAR(255),
  "owner_email" VARCHAR(255),
  "contact_email" VARCHAR(255),
  "currency" VARCHAR(3),
  "marketing_consent" BOOLEAN,
  "created_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "updated_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "session_id" VARCHAR(255),
  "is_deleted" BOOLEAN DEFAULT FALSE,
  "deleted_at" TIMESTAMPTZ DEFAULT NULL,
  PRIMARY KEY ("id")
);

CREATE INDEX idx_shop_session_id ON "shop" ("session_id");
CREATE UNIQUE INDEX idx_shop_shopify_id ON "shop" ("shopify_id");

CREATE TABLE "widgets" (
  "id" UUID DEFAULT gen_random_uuid(),
  "name" VARCHAR(255),
  "type" VARCHAR(20) NOT NULL,
  "is_active" BOOLEAN,
  "display_position" VARCHAR(20),
  "target_page_types" JSON,
  "created_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "updated_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "shop_id" UUID,
  PRIMARY KEY ("id"),
  CONSTRAINT "FK_shop" FOREIGN KEY ("shop_id") REFERENCES shop("id") ON DELETE CASCADE
);

CREATE UNIQUE INDEX idx_shop_widgets ON "widgets" ("shop_id", "name");

CREATE TABLE "product_widget_config" (
  "id" UUID DEFAULT gen_random_uuid(),
  "layout" VARCHAR(15) NOT NULL,
  "layout_config" JSON NOT NULL,
  "is_active" BOOLEAN,
  "metric" VARCHAR(20),
  "operator" VARCHAR(5),
  "threshold" DECIMAL,
  "message" VARCHAR(255),
  "created_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "updated_at" TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
  "widget_id" UUID,
  PRIMARY KEY ("id"),
  CONSTRAINT "FK_product_widget" FOREIGN KEY ("widget_id") REFERENCES widgets("id") ON DELETE CASCADE
);

CREATE UNIQUE INDEX idx_product_widget_config ON "product_widget_config" ("widget_id", "metric", "operator", "threshold");
